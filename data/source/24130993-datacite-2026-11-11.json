{"data":{"id":"10.5281/zenodo.24130993","type":"dois","attributes":{"doi":"10.5281/zenodo.24130993","prefix":"10.5281","suffix":"zenodo.24130993","identifiers":[{"identifier":"oai:zenodo.org:24130993","identifierType":"oai"}],"alternateIdentifiers":[{"alternateIdentifierType":"oai","alternateIdentifier":"oai:zenodo.org:24130993"}],"creators":[{"name":"Vale, Dorian","nameType":"Personal","givenName":"Dorian","familyName":"Vale","nameIdentifiers":[{"nameIdentifier":"0009-0004-7737-5094","nameIdentifierScheme":"ORCID"}],"affiliation":[]}],"titles":[{"title":"When Interpretation Becomes Authority"}],"publisher":"Museum of One","container":{},"publicationYear":2026,"subjects":[{"subject":"Alexander Viktorovich Markov"},{"subject":"Александр Викторович Марков"},{"subject":"Alexander V. Markov"},{"subject":"Dorian Vale"},{"subject":"Post-Interpretive Criticism"},{"subject":"Semiotics of Non-intentional Ephemerality"},{"subject":"Semantic protocol"},{"subject":"Successional authority"},{"subject":"Deactivation gap"},{"subject":"Recognition closure"},{"subject":"Interpretive authority"},{"subject":"Museum cataloguing"},{"subject":"Art criticism"},{"subject":"Museum studies"},{"subject":"Rijksmuseum"},{"subject":"Simon Maris"}],"contributors":[{"name":"Markov, Alexander Viktorovich","nameType":"Personal","givenName":"Alexander Viktorovich","familyName":"Markov","contributorType":"Other","nameIdentifiers":[],"affiliation":[]}],"dates":[{"date":"2026-11-11","dateType":"Issued"}],"language":"en","types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Other","resourceTypeGeneral":"Text"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.24130992","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1.0","rightsList":[{"rights":"In Copyright","rightsUri":"https://rightsstatements.org/page/InC/1.0/"},{"rights":"© 2026 Dorian Vale · Museum of One. Editorial text by Dorian Vale. Rights in the original correspondence remain with its respective authors.","rightsUri":"http://rightsstatements.org/vocab/InC/1.0/"}],"descriptions":[{"description":"A Museum of One research dialogue between Post-Interpretive Criticism (PIC) and the Semiotics of Non-intentional Ephemerality (SNE). Dorian Vale’s editorial account follows his scholarly exchange with Alexander V. Markov (Alexander Viktorovich Markov; Александр Викторович Марков) on how interpretations acquire authority when they become museum labels, catalogue descriptions, teaching conventions, and search terms. It traces the semantic protocol, successional authority, the deactivation gap, recognition closure, and the responsibilities of contestability. The account distinguishes the persistence of wording from its reauthorization and connects the theoretical exchange to Vale’s separately authored documentary study of the Rijksmuseum’s retitling of Simon Maris’s Isabella. Markov’s intellectual contributions are attributed throughout. The text paraphrases correspondence and preserves the provenance of the proposals. Version 1.0, October 2026 edition, 9 pages. Museum of One programme: https://www.museumofone.art/research-critical-language/#programme-outputs. Related working paper: https://doi.org/10.5281/zenodo.23430200.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://zenodo.org/doi/10.5281/zenodo.24130993","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-11-11T08:57:41.000Z","registered":"2026-11-11T08:57:41.000Z","published":"2026","updated":"2026-11-11T08:57:41.000Z"},"relationships":{"client":{"data":{"id":"cern.zenodo","type"